# Copy to `.env.local` for local runs. In CapRover, set these per app under
# "App Configs > Environment Variables". Never put a seed phrase, mnemonic or
# private key in any env file: Qwakk never signs on the server.
#
# Testnet and mainnet are separate deployments (separate web, indexer and
# PostgreSQL apps). Never point two networks at the same database.

# Network preset: testnet (QoreChain Diana, qorechain-diana) or mainnet
# (qorechain-vladi). Default testnet. Unknown values fall back to testnet.
# Set it on BOTH the web app and the indexer of a deployment.
QWAKK_NETWORK=testnet

# Optional endpoint overrides (for example a private node). Leave them
# commented out: the preset for QWAKK_NETWORK supplies the public endpoints.
#   testnet: https://api-testnet.qore.host  https://rpc-testnet.qore.host  https://evm-testnet.qore.host
#   mainnet: https://api.qore.host          https://rpc.qore.host          https://evm.qore.host
# A value equal to the other network's public endpoint is ignored with a
# warning. The Diana testnet RPC prunes old blocks (about six days kept);
# mainnet keeps all blocks.
# QORECHAIN_REST_URL=
# QORECHAIN_RPC_URL=
# QORECHAIN_EVM_RPC_URL=

# CapRover runs the same image as either `web` or `indexer`.
QWAKK_PROCESS_ROLE=web

# Market indexer URL read by the web app. Local default below; in CapRover use
# http://srv-captain--<indexer-app-name>:4400.
QWAKK_INDEXER_URL=http://localhost:4400

# Indexer only: PostgreSQL connection and listen port.
DATABASE_URL=postgresql://qwakk:qwakk_local@localhost:5438/qwakk
QWAKK_INDEXER_PORT=4400

# Optional first block for a fresh indexer database. Leave empty to start at the
# current height. The node must still keep this block (Diana prunes).
QWAKK_INDEXER_START_HEIGHT=

# Public QoreChain address that receives Qwakk's disclosed interface fee.
# Public address only, checksum-valid qor1. Anything else turns the fee off.
# Use a different treasury per network.
QWAKK_TREASURY_ADDRESS=

# Interface fee in basis points: 10 = 0.10% of the input amount. A whole number
# from 0 to 30 (0.30% cap). Anything else turns the fee off.
QWAKK_SWAP_FEE_BPS=10

# Wallet actions. Read per request, so a change applies without a rebuild.
# Empty or "off": all off (default). "enabled", "true" or "all": all on. Or a
# comma list of swap, liquidity, add_liquidity, remove_liquidity, create_pool.
QWAKK_NATIVE_ACTIONS=

# Emergency blocklist, read per request. Comma list of AMM pool ids (3,7) and
# of exact denoms (erc20:0x...,ibc/...). Blocked pools and tokens cannot be
# quoted or prepared.
QWAKK_BLOCKED_POOL_IDS=
QWAKK_BLOCKED_DENOMS=

# Deep /api/health fails when the indexer is more than this many blocks behind
# the chain [600]. Container liveness uses /api/health?shallow=1 instead.
QWAKK_HEALTH_MAX_INDEXER_LAG=

# API rate limiting (per client IP, in memory, see lib/qwakk-rate-limit.ts).
# "off" disables it, for example while debugging a proxy that hides client IPs.
QWAKK_RATE_LIMIT=
# Reverse proxies in front of the app that append to X-Forwarded-For.
# 1 = CapRover nginx only (default). 2 = another proxy such as Cloudflare in
# front of CapRover. Never raise it without such a proxy: clients could then
# choose their own rate limit key.
QWAKK_TRUSTED_PROXY_HOPS=

# Optional CoinGecko demo API key for QOR market data.
COINGECKO_API_KEY=

# Public site address used for share previews. Defaults to https://qwakk.fun.
QWAKK_SITE_URL=

# Testnet points program. Points rank on-chain activity on Qwakk pools; they
# have no monetary value. The public API stays off until this is "enabled".
# Set it on both the web app and the indexer. Raw data is collected either way.
QWAKK_POINTS_ENABLED=

# The rest is read by the indexer only. Empty means the default in brackets.
# A changed value applies on the next indexer start and rescores the season.
# Season name [testnet-1], first block [0 = first indexed], last block [open].
QWAKK_POINTS_SEASON=
QWAKK_POINTS_SEASON_START_HEIGHT=
QWAKK_POINTS_SEASON_END_HEIGHT=
# Comma separated qor1 addresses kept off the leaderboard (owner, test wallets).
# QWAKK_TREASURY_ADDRESS is excluded automatically when set on the indexer.
QWAKK_POINTS_EXCLUDED_ADDRESSES=
# Swaps: smallest counted swap in QOR [1], points per QOR [1], daily volume at
# full rate in QOR [1000], daily volume ceiling in QOR [10000], rate between the
# two in bps [2000 = 20%].
QWAKK_POINTS_MIN_SWAP_QOR=
QWAKK_POINTS_SWAP_POINTS_PER_QOR=
QWAKK_POINTS_SWAP_DAILY_FULL_QOR=
QWAKK_POINTS_SWAP_DAILY_MAX_QOR=
QWAKK_POINTS_SWAP_EXCESS_FACTOR_BPS=
# A swap reversed in the same pool by the same address within this many seconds
# [1800] is a round trip; both legs then count at this weight in bps [1000 = 10%].
QWAKK_POINTS_ROUND_TRIP_WINDOW_SECONDS=
QWAKK_POINTS_ROUND_TRIP_FACTOR_BPS=
# Liquidity: points per QOR-hour held [0.01], hourly position value at full rate
# in QOR [5000], hourly value ceiling in QOR [50000], rate between them in bps
# [2000], minimum consecutive hours held before any hour counts [6], longest
# snapshot gap still credited in hours [3]. Pools without a QOR side score 0.
QWAKK_POINTS_LP_POINTS_PER_QOR_HOUR=
QWAKK_POINTS_LP_HOURLY_FULL_QOR=
QWAKK_POINTS_LP_HOURLY_MAX_QOR=
QWAKK_POINTS_LP_EXCESS_FACTOR_BPS=
QWAKK_POINTS_LP_MIN_HOLD_HOURS=
QWAKK_POINTS_LP_MAX_INTERVAL_HOURS=
# Pool creation: one-time points [500] once this many other addresses made
# counted swaps in the pool [5], for at most this many pools per creator [3].
QWAKK_POINTS_POOL_BONUS=
QWAKK_POINTS_POOL_BONUS_MIN_TRADERS=
QWAKK_POINTS_POOL_BONUS_MAX_PER_ADDRESS=
# Activity: points per UTC day with a qualifying action [50]; a liquidity add or
# pool creation qualifies from this many QOR on its QOR side [1].
QWAKK_POINTS_ACTIVE_DAY_POINTS=
QWAKK_POINTS_MIN_ACTION_QOR=
