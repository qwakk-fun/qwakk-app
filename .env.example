# Public QoreChain address that receives Qwakk's disclosed application fee.
# Set this in CapRover; never put a seed phrase or private key here.
QWAKK_TREASURY_ADDRESS=

# 10 basis points = 0.10% of the input amount. Hard cap: 30 (0.30%).
QWAKK_SWAP_FEE_BPS=10

# Market indexer URL. Local Docker defaults to this address.
QWAKK_INDEXER_URL=http://localhost:4400

# Optional first block for a fresh indexer database. Leave empty to start at the
# current height. The node must still keep this block.
QWAKK_INDEXER_START_HEIGHT=

# Diana testnet endpoints used by the server and the indexer.
QORECHAIN_REST_URL=https://api-testnet.qore.host
QORECHAIN_RPC_URL=https://rpc-testnet.qore.host
QORECHAIN_EVM_RPC_URL=https://evm-testnet.qore.host

# CapRover runs the same image as either `web` or `indexer`.
QWAKK_PROCESS_ROLE=web

# Wallet actions (swap, pools, liquidity). Set to "enabled" only after the
# signing probe succeeds on QoreChain Diana. Read at runtime.
QWAKK_NATIVE_ACTIONS=

# Optional CoinGecko demo API key for QOR market data.
COINGECKO_API_KEY=

# Public site address used for share previews. Defaults to https://qwakk.fun.
QWAKK_SITE_URL=
