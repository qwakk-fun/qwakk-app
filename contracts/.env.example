# Qwakk Pond Vault: copy to contracts/.env (git ignores it) and fill in locally.
# The CLI (npm run pond in contracts/cli) and forge both read this file.
#
# Use a TESTNET-ONLY mnemonic made for this vault. Never reuse it on mainnet,
# never commit it, never paste it into the web app, a server or CapRover.

# --- Keys (secrets, testnet only) -------------------------------------------

# The owner: sends every vault transaction and opens its EVM windows.
# Account 0 of this mnemonic (m/44'/60'/0'/0/0) is the owner; its ML-DSA-87 key
# is derived from the same mnemonic by @qorechain/sdk deriveUnifiedAccount.
QORE_MNEMONIC=
# QORE_ACCOUNT_INDEX=0

# Optional: a separate approver whose registered ML-DSA-87 key signs approvals.
# Leave empty to let the owner's own key approve. With a separate approver,
# keep this mnemonic on another machine and use `approve ... --out file`.
QORE_APPROVER_MNEMONIC=
# QORE_APPROVER_ACCOUNT_INDEX=0

# --- Network -----------------------------------------------------------------

# Only testnet (QoreChain Diana): pqcVerify and pqcKeyStatus are not active on mainnet.
QORE_NETWORK=testnet
# Optional overrides (the public Diana endpoints are rate limited per IP).
# QORE_REST_URL=https://api-testnet.qore.host
# QORE_RPC_URL=https://rpc-testnet.qore.host
# QORE_EVM_RPC_URL=https://evm-testnet.qore.host

# --- Deploy -------------------------------------------------------------------

# Seconds between queueing and executing an action (60 to 2592000).
# 120 keeps the live smoke test short; use hours or days for real funds.
POND_TIMELOCK_SECONDS=120
# Daily withdrawal cap for native QOR. ERC-20 caps start at 0 (locked) and are
# raised with an approved `queue cap` action.
POND_NATIVE_DAILY_CAP_QOR=10
# Optional guardian (may pause and cancel, nothing else). Leave commented for none.
# POND_GUARDIAN=0x...

# --- After deploy ---------------------------------------------------------------

# Printed by `npm run pond -- deploy`.
POND_VAULT_ADDRESS=

# --- Optional tuning -----------------------------------------------------------

# Window size. Diana makes about 0.7 blocks per second, so 1800 blocks is about 43 minutes.
QORE_WINDOW_BLOCKS=1800
# QORE_WINDOW_MAX_UQOR=
# Extra 0x targets for the vault window, comma separated (for example a token to approve).
# POND_WINDOW_EXTRA_TARGETS=
# Fee cap per EVM transaction, in gwei. The window is sized with the same number.
POND_MAX_FEE_GWEI=250
# How long a fresh approval stays valid, in seconds (at most 86400).
POND_APPROVAL_TTL_SECONDS=900
# Smoke test amounts.
POND_SMOKE_DEPOSIT_QOR=0.01
POND_SMOKE_WITHDRAW_QOR=0.005
